---
import { featureFlags } from "@config/featureFlag/featureFlag.json";
import authorConfig from "@config/siteConfig/info.json";

type NavItem = { href: string; label: string; external?: boolean };

const primary: NavItem[] = [
	featureFlags.showProjects && { href: "/project/", label: "Work" },
	featureFlags.showBlog && { href: "/blog/", label: "Writing" },
	featureFlags.showAbout && { href: "/about/", label: "About" },
	featureFlags.showExperience && { href: "/experience/", label: "Experience" },
	featureFlags.showOpenSource && {
		href: "/open-source/",
		label: "Open Source",
	},
	featureFlags.showTrendingPosts && { href: "/trending/", label: "Trending" },
	featureFlags.showWiki && {
		href: "https://rafay99-docs.vercel.app/",
		label: "Wiki",
		external: true,
	},
].filter((item): item is NavItem => Boolean(item));

const utility: NavItem[] = [
	featureFlags.showTags && { href: "/tag/", label: "Tags" },
	featureFlags.showSearch && { href: "/search/", label: "Search" },
].filter((item): item is NavItem => Boolean(item));

const path = Astro.url.pathname;
const isActive = (href: string) =>
	path.startsWith(href) || (href === "/blog/" && path.startsWith("/tag/"));
const external = { target: "_blank", rel: "noopener noreferrer" };
---

<header id="site-header" class="hdr" style={{ viewTransitionName: "header" }}>
  <div class="hdr__bar">
    <a href="/" class="hdr__name" aria-label={`${authorConfig.SiteName}, home`}>
      {authorConfig.SiteName}
    </a>

    <nav class="hdr__nav" aria-label="Primary">
      {
        primary.map((item) => (
          <a
            href={item.href}
            class:list={["hdr__link", { "is-active": isActive(item.href) }]}
            aria-current={isActive(item.href) ? "page" : undefined}
            {...(item.external ? external : {})}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hdr__util">
      {
        utility.map((item) => (
          <a
            href={item.href}
            class:list={["hdr__util-link", { "is-active": path.startsWith(item.href) }]}
          >
            {item.label}
          </a>
        ))
      }
      <button
        type="button"
        class="hdr__menu-btn"
        data-menu-toggle
        aria-controls="site-menu"
        aria-expanded="false"
      >
        Menu
      </button>
    </div>
  </div>
</header>

<div id="site-menu" class="menu" aria-hidden="true">
  <div class="menu__top">
    <a href="/" class="hdr__name">{authorConfig.SiteName}</a>
    <button type="button" class="hdr__menu-btn is-close" data-menu-toggle>
      Close
    </button>
  </div>
  <nav class="menu__nav" aria-label="Mobile">
    <a href="/" class="menu__link" style="--i:0" tabindex="-1">Home</a>
    {
      [...primary, ...utility].map((item, i) => (
        <a
          href={item.href}
          class:list={["menu__link", { "is-active": isActive(item.href) }]}
          style={`--i:${i + 1}`}
          tabindex="-1"
          {...(item.external ? external : {})}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
  <p class="menu__foot">{authorConfig.jobTitle}</p>
</div>

<script>
  const root = document.documentElement;
  let opener: HTMLElement | null = null;

  const menuEl = () => document.getElementById("site-menu");
  const isOpen = () => root.classList.contains("menu-open");

  function setMenu(open: boolean, { restoreFocus = true } = {}) {
    const menu = menuEl();
    if (!menu) return;
    root.classList.toggle("menu-open", open);
    menu.setAttribute("aria-hidden", String(!open));
    for (const link of menu.querySelectorAll("a")) {
      link.tabIndex = open ? 0 : -1;
    }
    for (const btn of document.querySelectorAll("[data-menu-toggle]")) {
      btn.setAttribute("aria-expanded", String(open));
    }
    document.body.style.overflow = open ? "hidden" : "";

    if (open) {
      opener = document.activeElement as HTMLElement | null;
      menu.querySelector<HTMLElement>("[data-menu-toggle]")?.focus();
    } else {
      if (restoreFocus) opener?.focus();
      opener = null;
    }
  }

  function trapFocus(e: KeyboardEvent) {
    const menu = menuEl();
    if (!menu) return;
    const focusable = [...menu.querySelectorAll<HTMLElement>("a, button")];
    const first = focusable[0];
    const last = focusable.at(-1);
    if (!first || !last) return;
    const active = document.activeElement;
    if (e.shiftKey && (active === first || !menu.contains(active))) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && (active === last || !menu.contains(active))) {
      e.preventDefault();
      first.focus();
    }
  }

  function syncScrolled() {
    document
      .getElementById("site-header")
      ?.classList.toggle("is-scrolled", window.scrollY > 8);
  }

  document.addEventListener("click", (e) => {
    const target = e.target as Element | null;
    if (target?.closest("[data-menu-toggle]")) setMenu(!isOpen());
  });
  document.addEventListener("keydown", (e) => {
    if (!isOpen()) return;
    if (e.key === "Escape") setMenu(false);
    if (e.key === "Tab") trapFocus(e);
  });
  window.addEventListener("scroll", syncScrolled, { passive: true });
  document.addEventListener("astro:page-load", () => {
    setMenu(false, { restoreFocus: false });
    syncScrolled();
  });
</script>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--dur-2),
      border-color var(--dur-2);
  }

  .hdr.is-scrolled {
    background-color: rgb(26 27 38 / 0.86);
    border-bottom-color: var(--color-line);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .hdr__bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 4rem;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
    font-family: var(--font-sans);
  }

  .hdr__name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    text-decoration: none;
    white-space: nowrap;
  }

  .hdr__nav {
    display: flex;
    gap: 1.75rem;
    margin-left: auto;
  }

  .hdr__link,
  .hdr__util-link {
    position: relative;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--dur-1);
  }

  .hdr__link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.35rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .hdr__link:hover,
  .hdr__util-link:hover,
  .hdr__link.is-active,
  .hdr__util-link.is-active {
    color: var(--color-text-primary);
  }

  .hdr__link:hover::after,
  .hdr__link.is-active::after {
    transform: scaleX(1);
  }

  .hdr__util {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-left: 1.75rem;
    border-left: 1px solid var(--color-line);
  }

  .hdr__util-link {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-soft);
  }

  .hdr__menu-btn {
    display: none;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-primary);
    background: none;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    cursor: pointer;
  }

  @media (pointer: coarse) {
    .hdr__menu-btn {
      min-height: 2.75rem;
    }
  }

  .hdr__link:focus-visible,
  .hdr__util-link:focus-visible,
  .hdr__name:focus-visible,
  .hdr__menu-btn:focus-visible,
  .menu__link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
  }

  @media (max-width: 1023px) {
    .hdr__nav,
    .hdr__util-link {
      display: none;
    }

    .hdr__util {
      margin-left: auto;
      border-left: 0;
      padding-left: 0;
    }

    .hdr__menu-btn {
      display: inline-flex;
    }
  }

  .menu {
    position: fixed;
    overflow-y: auto;
    overscroll-behavior: contain;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    padding: 0 clamp(1.25rem, 4vw, 3rem) 2rem;
    background-color: var(--color-bg-primary);
    visibility: hidden;
    opacity: 0;
    transition:
      opacity var(--dur-2),
      visibility 0s linear var(--dur-2);
  }

  :global(.menu-open) .menu {
    visibility: visible;
    opacity: 1;
    transition: opacity var(--dur-2);
  }

  .menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }

  .menu__top .is-close {
    display: inline-flex;
  }

  .menu__nav {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: 2rem;
  }

  .menu__link {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 9vw, 3.75rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.045em;
    color: var(--color-text-primary);
    text-decoration: none;
    opacity: 0;
    transform: translateY(1.25rem);
    transition:
      opacity 0.4s,
      transform 0.6s var(--ease-out),
      color var(--dur-1);
  }

  :global(.menu-open) .menu__link {
    opacity: 1;
    transform: none;
    transition-delay: calc(var(--i) * 45ms);
  }

  .menu__link.is-active,
  .menu__link:hover {
    color: var(--color-secondary);
  }

  .menu__foot {
    margin: auto 0 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu,
    .menu__link {
      transition: none;
    }
  }
</style>
