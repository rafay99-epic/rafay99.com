---
import { accentAt, startYear } from "@astro/editorial/format";
import PageHead from "@astro/editorial/PageHead.astro";
import authorConfig from "@config/siteConfig/info.json";

const { workExperience } = authorConfig;
const WORDS = [
	"Zero",
	"One",
	"Two",
	"Three",
	"Four",
	"Five",
	"Six",
	"Seven",
	"Eight",
	"Nine",
	"Ten",
];
const count = WORDS[workExperience.length] ?? String(workExperience.length);

type Role = { job: (typeof workExperience)[number]; color: string };
const byYear = new Map<number, Role[]>();
workExperience.forEach((job, i) => {
	const year = startYear(job.employmentTime);
	byYear.set(year, [...(byYear.get(year) ?? []), { job, color: accentAt(i) }]);
});
const firstYear = Math.min(...byYear.keys());
---

<PageHead
  lines={[`${count} roles.`, "One direction:", "closer to the model."]}
  accent={2}
  lede={`From TensorFlow models in ${firstYear} to AI systems in production today, via mobile, web and a team to lead.`}
>
  <div slot="aside" class="ed-stats">
    <span class="ed-stat"><b>{new Date().getFullYear() - firstYear}</b>years</span>
    <span class="ed-stat"><b>{workExperience.length}</b>companies</span>
  </div>
</PageHead>

<div class="ed-wrap xp">
  {
    [...byYear].map(([year, roles]) => (
      <section class="xp__year" style={`--c:${roles[0]?.color}`} aria-label={String(year)}>
        <span class="xp__num" aria-hidden="true">{year}</span>
        <div>
          {roles.map(({ job, color }) => {
            return (
              <article class="xp__role" style={`--c:${color}`} data-rev>
                <h2 class="xp__company">{job.companyName}</h2>
                <p class="ed-mono xp__pos">
                  {job.position} · {job.employmentTime.replace(/\s-\s/, " → ")}
                </p>
                <ul class="xp__list">
                  {job.roles.map((line) => <li>{line}</li>)}
                </ul>
                <p class="ed-mono xp__tools">{job.toolsUsed.join(" · ")}</p>
              </article>
            );
          })}
        </div>
      </section>
    ))
  }
</div>

<style>
  .xp {
    padding-block: clamp(2rem, 5vw, 4rem) clamp(4rem, 10vw, 8rem);
  }

  .xp__year {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-top: 1.5rem;
    margin-top: 2.5rem;
    border-top: 1px solid var(--color-line);
  }

  .xp__num {
    position: sticky;
    top: 5.5rem;
    align-self: start;
    padding-right: 0.08em;
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 12vw, 10.5rem);
    font-weight: 700;
    line-height: 0.8;
    letter-spacing: -0.03em;
    white-space: nowrap;
    color: transparent;
    background:
      linear-gradient(var(--c), var(--c)) no-repeat left bottom / 100% 100%,
      linear-gradient(var(--color-line), var(--color-line));
    -webkit-background-clip: text;
    background-clip: text;
  }

  @supports (animation-timeline: view()) {
    .xp__num {
      animation: xp-fill linear both;
      animation-timeline: view();
      animation-range: entry 20% cover 45%;
    }
  }

  @keyframes xp-fill {
    from {
      background-size:
        100% 0%,
        auto;
    }
  }

  .xp__role {
    padding-bottom: 2.5rem;
  }

  .xp__role + .xp__role {
    padding-top: 2rem;
    border-top: 1px dashed var(--color-line);
  }

  .xp__company {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--color-text-primary);
  }

  .xp__pos {
    margin-top: 0.5rem;
    color: var(--c);
  }

  .xp__list {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.25rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .xp__list li {
    position: relative;
    padding-left: 1.25rem;
  }

  .xp__list li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--color-text-muted);
  }

  .xp__tools {
    margin-top: 1.25rem;
  }

  @media (max-width: 767px) {
    .xp__year {
      grid-template-columns: 1fr;
    }

    .xp__num {
      position: static;
    }
  }
</style>
