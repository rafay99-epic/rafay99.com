---
import { accentAt } from "@astro/editorial/format";
import PageHead from "@astro/editorial/PageHead.astro";
import authorConfig from "@config/siteConfig/info.json";

type Entry = {
	project: string;
	context: string;
	status: string;
	body: string[];
	tags: string[];
	links: { label: string; href: string }[];
};

const tools: Entry[] = [
	{
		project: "cvx",
		context: "Multi-account switcher for Convex · used daily by my team",
		status: "Maintained",
		body: [
			"The Convex CLI remembers one logged-in account, stored in a single global file. With personal, work and client accounts, every project switch meant `convex logout` and `convex login`, and two accounts could never run side by side.",
			"`cvx` keeps a vault of account tokens and a map of folders to accounts. A shell hook activates the right account when you `cd` in, scoped to that shell session, so six projects on six accounts can run `convex dev` at once. No deploy keys, no tokens in repos. Ships as a compiled Bun binary for macOS, Linux and Windows.",
		],
		tags: ["TypeScript", "Bun", "zsh / bash / PowerShell"],
		links: [
			{ label: "GitHub", href: "https://github.com/rafay99-epic/cvx" },
			{ label: "npm", href: "https://www.npmjs.com/package/@rafay99/cvx" },
		],
	},
	{
		project: "fvx",
		context: "Per-project Flutter SDK switching · used daily by my team",
		status: "Maintained",
		body: [
			"Run `flutter` in any folder and get the SDK version that folder pins, from `.fvmrc`, `.tool-versions` or a `pubspec.yaml` range. Two terminals in two projects run two Flutter versions at the same time.",
			"There is no cd hook. `fvx setup` puts `flutter` and `dart` shims first on PATH, and each call resolves the version in about 10 ms. That makes it work where shell hooks never run: scripts, Makefiles, CI and coding agents in non-interactive shells. It reads the same `.fvmrc` FVM writes, so teammates on FVM get the same pin.",
		],
		tags: ["TypeScript", "Bun", "Flutter"],
		links: [
			{ label: "fvx.rafay99.com", href: "https://fvx.rafay99.com" },
			{ label: "GitHub", href: "https://github.com/rafay99-epic/fvx" },
			{ label: "npm", href: "https://www.npmjs.com/package/@rafay99/fvx" },
		],
	},
	{
		project: "Coppice",
		context: "macOS menu bar app for coding agent worktrees",
		status: "Maintained",
		body: [
			"Coding agents create a git worktree for every task and never clean up. After a few weeks one laptop holds dozens of forgotten copies of the same repo, each with its own `node_modules`, and some still hold uncommitted edits, a local `.env` or a running agent.",
			"Coppice finds worktrees from Claude Code, Codex, Cursor, T3 Code and others, and marks each one ready, has work, or in use. It sweeps rebuildable output, moves finished worktrees to the Trash, and refuses to touch one an agent or dev server is still running in. Every check runs again at the moment you click. Native Swift and SwiftUI, no third-party dependencies.",
		],
		tags: ["Swift", "SwiftUI", "git"],
		links: [
			{ label: "coppice.rafay99.com", href: "https://coppice.rafay99.com" },
			{ label: "GitHub", href: "https://github.com/rafay99-epic/Coppice" },
			{
				label: "Download",
				href: "https://github.com/rafay99-epic/Coppice/releases/latest",
			},
		],
	},
];

const contributions: Entry[] = [
	{
		project: "Mole",
		context: "macOS deep-clean utility by tw93 · 51k+ stars",
		status: "Merged",
		body: [
			"I added a `--list` flag to `mo uninstall` that enumerates installed applications across system, user, Homebrew and Setapp sources, surfacing both the display name and the exact Homebrew cask token needed to uninstall. Written in Bash with 12 bats test cases covering edge cases across every source.",
			"The maintainer said my first design added too much top-level surface to the CLI. He was right. I moved the capability from a standalone `mo list` command into a flag on the existing `uninstall` command, keeping the API small, and he merged it after the revision.",
		],
		tags: ["Bash", "bats", "CLI design"],
		links: [
			{ label: "PR #755", href: "https://github.com/tw93/Mole/pull/755" },
		],
	},
	{
		project: "TLDR Pages",
		context: "Community-maintained simplified man pages",
		status: "5 PRs merged",
		body: [
			"Five merged pull requests adding new platform pages and improving existing CLI documentation, including a `swaylock` page for the Linux/Wayland ecosystem. Each page follows the project's strict format: concise, example-driven, nothing extra.",
		],
		tags: ["Documentation", "Linux / Wayland", "CLI references"],
		links: ["9889", "9890", "10604", "10609", "10628"].map((pr) => ({
			label: `#${pr}`,
			href: `https://github.com/tldr-pages/tldr/pull/${pr}`,
		})),
	},
	{
		project: "TinaCMS",
		context: "Open-source headless CMS",
		status: "Bug reports",
		body: [
			"Filed reproducible bug reports against subsystems where the codebase made a direct fix hard to scope from outside. Each report had minimal reproduction steps, environment details and an analysis of where the issue likely started, so maintainers had a clear place to begin.",
		],
		tags: ["Bug reporting", "CMS internals", "Reproductions"],
		links: [],
	},
];

const groups = [
	{ title: "Tools I maintain", entries: tools },
	{ title: "Contributions", entries: contributions },
];

const mergedPrs = contributions.reduce((n, c) => n + c.links.length, 0);
const segments = (text: string) => text.split("`");
---

<PageHead
  lines={["I build and fix", "the tools I use."]}
  accent={1}
  lede="Some tools I built because nothing did the job, and my team now runs them every day. The rest are fixes to projects I rely on, shipped through the feedback loop with their maintainers."
>
  <div slot="aside" class="ed-stats">
    <span class="ed-stat"><b>{tools.length}</b>tools</span>
    <span class="ed-stat"><b>{mergedPrs}</b>merged PRs</span>
    <span class="ed-stat"><b>{contributions.length}</b>projects</span>
  </div>
</PageHead>

<div class="ed-wrap oss">
  {
    groups.map((g) => (
      <section class="oss__group">
        <div class="ed-section__head">
          <h2 class="ed-h2">{g.title}</h2>
          <span class="ed-mono">{g.entries.length}</span>
        </div>
        {g.entries.map((c, i) => (
          <article class="oss__item" style={`--c:${accentAt(i)}`} data-rev>
            <div class="oss__side">
              <span class="ed-mono">{String(i + 1).padStart(2, "0")}</span>
              <p class="ed-mono oss__status">{c.status}</p>
            </div>
            <div>
              <h3 class="oss__name">{c.project}</h3>
              <p class="ed-mono oss__context">{c.context}</p>
              {c.body.map((p) => (
                <p class="oss__p">
                  {segments(p).map((part, j) => (j % 2 ? <code>{part}</code> : part))}
                </p>
              ))}
              <div class="oss__foot">
                <p class="ed-mono">{c.tags.join(" · ")}</p>
                {c.links.length > 0 && (
                  <p class="ed-mono oss__links">
                    {c.links.map((l) => (
                      <a class="ed-link" href={l.href} target="_blank" rel="noopener noreferrer">
                        {l.label} ↗
                      </a>
                    ))}
                  </p>
                )}
              </div>
            </div>
          </article>
        ))}
      </section>
    ))
  }

  <p class="ed-mono oss__more">
    <a
      class="ed-link"
      href={authorConfig.socialLinks.github}
      target="_blank"
      rel="noopener noreferrer">Everything else is on GitHub ↗</a
    >
    <a class="ed-link" href="/project/">Things I've shipped →</a>
  </p>
</div>

<style>
  .oss {
    padding-block: clamp(2rem, 5vw, 4rem) clamp(3rem, 7vw, 5rem);
  }

  .oss__item {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 2rem;
    padding-block: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--color-line);
  }

  .oss__group + .oss__group {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .ed-section__head + .oss__item {
    border-top: 0;
  }

  .oss__side {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .oss__status {
    color: var(--c);
  }

  .oss__name {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.05em;
    color: var(--color-text-primary);
  }

  .oss__context {
    margin-top: 0.6rem;
  }

  .oss__p {
    max-width: 44rem;
    margin-top: 1.1rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .oss__p code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: var(--color-bg-secondary);
    color: var(--c);
  }

  .oss__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    max-width: 44rem;
    margin-top: 1.5rem;
  }

  .oss__links,
  .oss__more {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    color: var(--color-text-primary);
  }

  .oss__more {
    padding-top: 2rem;
    border-top: 1px solid var(--color-line);
  }

  @media (max-width: 767px) {
    .oss__item {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .oss__side {
      flex-direction: row;
      gap: 1rem;
    }
  }
</style>
