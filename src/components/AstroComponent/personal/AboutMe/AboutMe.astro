---
import PageHead from "@astro/editorial/PageHead.astro";
import authorConfig from "@config/siteConfig/info.json";

const { about, techStack, picture, name, tag_line } = authorConfig;
// whoAmI is one long paragraph: the first sentence becomes the serif lede,
// the next two the body. The rest (AI opinions) lives in its own section.
const [lede = "", ...rest] = about.whoAmI.split(/(?<=\.)\s+/);
const whoBody = rest.slice(0, 2);

const sections = [
	"Who",
	"Principles",
	"On AI",
	"Stack",
	"Learning",
	"Off hours",
] as const;
const sectionId = (label: string) =>
	`about-${label.toLowerCase().replace(/\s+/g, "-")}`;
---

<PageHead lines={["I build", "complex things", "simply."]} accent={1} lede={tag_line} />

<div class="ed-wrap about">
  <nav class="about__spy" aria-label="About sections">
    {
      sections.map((label, i) => (
        <a href={`#${sectionId(label)}`} data-spy={sectionId(label)}>
          <span>{String(i + 1).padStart(2, "0")}</span> {label}
        </a>
      ))
    }
  </nav>

  <article class="about__essay">
    <section id={sectionId("Who")} class="about__sec about__who">
      <img
        src={picture}
        alt={`Portrait of ${name}`}
        width="1080"
        height="1080"
        loading="eager"
        decoding="async"
        class="about__portrait"
      />
      <p class="about__lede">{lede}</p>
      {whoBody.map((p) => <p class="about__p">{p}</p>)}
    </section>

    <section id={sectionId("Principles")} class="about__sec">
      <h2 class="about__h">Principles</h2>
      <ol class="about__princ">
        {
          about.principles.map((p, i) => (
            <li data-rev>
              <span class="ed-mono">{String(i + 1).padStart(2, "0")}</span>
              <p>
                <b>{p.title}</b> {p.body}
              </p>
            </li>
          ))
        }
      </ol>
    </section>

    <section id={sectionId("On AI")} class="about__sec">
      <h2 class="about__h">On AI</h2>
      <blockquote class="about__quote">
        <mark>{about.quote}</mark>
      </blockquote>
      <p class="about__p">{about.onAI}</p>
    </section>

    <section id={sectionId("Stack")} class="about__sec">
      <h2 class="about__h">Stack</h2>
      <dl class="about__stack">
        {
          techStack.map((group) => (
            <div data-rev>
              <dt>{group.category}</dt>
              <dd class="ed-mono">{group.tools.join(" · ")}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section id={sectionId("Learning")} class="about__sec">
      <h2 class="about__h">Learning</h2>
      <p class="about__p">{about.continuousLearning}</p>
    </section>

    <section id={sectionId("Off hours")} class="about__sec">
      <h2 class="about__h">Off hours</h2>
      <p class="about__p">{about.lifeBeyondCode}</p>
    </section>
  </article>
</div>

<script>
  // Highlights the section currently in view in the sticky index.
  let observer: IntersectionObserver | undefined;

  document.addEventListener("astro:page-load", () => {
    observer?.disconnect();
    const links = document.querySelectorAll<HTMLAnchorElement>("[data-spy]");
    if (links.length === 0) return;
    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          for (const link of links) {
            // An empty aria-current reads as "false"; use a real token.
            if (link.dataset.spy === entry.target.id) {
              link.setAttribute("aria-current", "location");
            } else {
              link.removeAttribute("aria-current");
            }
          }
        }
      },
      { rootMargin: "-20% 0px -65% 0px" },
    );
    for (const link of links) {
      const target = link.dataset.spy && document.getElementById(link.dataset.spy);
      if (target) observer.observe(target);
    }
  });
</script>

<style>
  .about {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    padding-block: clamp(3rem, 6vw, 5rem) clamp(4rem, 10vw, 8rem);
  }

  .about__spy {
    position: sticky;
    top: 6rem;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .about__spy a {
    color: var(--color-text-soft);
    transition:
      color var(--dur-1),
      transform var(--dur-2) var(--ease-out);
  }

  .about__spy a span {
    color: var(--color-text-muted);
  }

  .about__spy a:hover,
  .about__spy a[aria-current] {
    color: var(--color-text-primary);
    transform: translateX(0.4rem);
  }

  .about__essay {
    max-width: 42rem;
  }

  .about__sec {
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
    scroll-margin-top: 6rem;
  }

  .about__who::after {
    content: "";
    display: block;
    clear: both;
  }

  .about__portrait {
    float: right;
    width: min(13rem, 40%);
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    margin: 0.35rem 0 1rem 1.75rem;
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.6s var(--ease-out);
  }

  .about__portrait:hover {
    filter: none;
  }

  .about__lede {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    line-height: 1.2;
    color: var(--color-text-primary);
  }

  .about__p {
    margin-top: 1.1rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .about__h {
    margin-bottom: 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.4vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
  }

  .about__princ li {
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    padding-block: 0.9rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-text-secondary);
  }

  .about__princ li .ed-mono {
    padding-top: 0.2rem;
  }

  .about__princ b {
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .about__quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    line-height: 1.18;
    color: var(--color-text-primary);
  }

  .about__quote mark {
    color: inherit;
    background: linear-gradient(
        transparent 60%,
        color-mix(in srgb, var(--color-secondary) 42%, transparent) 60%
      )
      no-repeat left / 100% 100%;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  /* The marker sweeps across as the quote scrolls into view. */
  @supports (animation-timeline: view()) {
    .about__quote mark {
      animation: about-mark linear both;
      animation-timeline: view();
      animation-range: entry 40% cover 45%;
    }
  }

  @keyframes about-mark {
    from {
      background-size: 0% 100%;
    }
  }

  .about__stack div {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 1rem;
    padding-block: 0.9rem;
    border-top: 1px solid var(--color-line);
  }

  .about__stack dt {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .about__stack dd {
    margin: 0;
    padding-top: 0.15rem;
    color: var(--color-text-secondary);
  }

  @media (max-width: 767px) {
    .about {
      grid-template-columns: 1fr;
    }

    .about__spy {
      display: none;
    }

    .about__stack div {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
