---
import SeriesSidebarNav from "@astro/blog/series/SeriesSidebarNav.astro";
import ShareButtons from "@react/blog/interactions/socialButton";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import type { SeriesContext } from "types/series";

interface Props {
	tocEntries: MarkdownHeading[];
	isArchive: boolean;
	pageUrl: string;
	seriesContext?: SeriesContext | null | undefined;
}

const { tocEntries, isArchive, pageUrl, seriesContext } = Astro.props;
---

<button
	class="post-rail-fab"
	type="button"
	data-rail-fab
	aria-expanded="false"
	aria-controls="post-rail"
	aria-label="Open page actions and table of contents"
>
	<svg class="post-rail-fab-icon" aria-hidden="true" width="1em" height="1em" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h.01M3 12h.01M3 19h.01M8 5h13M8 12h13M8 19h13"/></svg>
</button>
<div class="post-rail-backdrop" data-rail-backdrop hidden></div>

<aside id="post-rail" class="post-rail post-rail--right">
	<button
		class="post-rail-close"
		type="button"
		data-rail-close
		aria-label="Close"
	>
		<svg class="post-rail-close-icon" aria-hidden="true" width="1em" height="1em" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 6L6 18M6 6l12 12"/></svg>
	</button>

	<div class="post-card post-card--engage">
		<div class="post-card-title">Quick actions</div>
		<div class="post-actions">
			<div class="post-action-menu" data-post-action-menu>
				<div class="post-action-split">
					<button
						class="post-action-main"
						type="button"
						data-copy-page-primary
					>
						<svg class="post-action-main-icon" aria-hidden="true" width="1em" height="1em" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></g></svg>
						<span class="post-action-main-label">Copy page</span>
						<span class="post-action-main-loader" aria-hidden="true"></span>
					</button>
					<button
						class="post-action-toggle"
						type="button"
						aria-haspopup="menu"
						aria-expanded="false"
						aria-controls="post-markdown-actions"
						data-post-action-toggle
					>
						<span class="post-action-chevron" aria-hidden="true">
							▾
						</span>
					</button>
				</div>
				<div
					class="post-action-dropdown"
					id="post-markdown-actions"
					role="menu"
					aria-label="Copy page actions"
					data-post-action-dropdown
					hidden
				>
					<button
						class="post-action-option"
						type="button"
						role="menuitem"
						data-open-markdown
					>
						<svg class="post-action-option-icon" aria-hidden="true" width="1em" height="1em" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 3h6v6m-11 5L21 3m-3 10v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
						<span class="post-action-option-label">Open Markdown</span>
						<span class="post-action-option-loader" aria-hidden="true"></span>
					</button>
					<button
						class="post-action-option"
						type="button"
						role="menuitem"
						data-ask-chatgpt
					>
						<Icon
							name="openai"
							class="post-action-option-icon"
							aria-hidden="true"
						/>
						<span class="post-action-option-label">Ask ChatGPT</span>
						<span class="post-action-option-loader" aria-hidden="true"></span>
					</button>
					<button
						class="post-action-option"
						type="button"
						role="menuitem"
						data-ask-claude
					>
						<Icon
							name="claude"
							class="post-action-option-icon"
							aria-hidden="true"
						/>
						<span class="post-action-option-label">Ask Claude</span>
						<span class="post-action-option-loader" aria-hidden="true"></span>
					</button>
				</div>
			</div>
		</div>
		<span
			class="post-action-status"
			data-copy-status
			aria-live="polite"></span>

		<div class="post-card-title post-card-title--inline">Share</div>
		<div class="post-actions-share" aria-label="Share on social">
			<ShareButtons
				url={pageUrl}
				pagetitle="Article"
				compact={true}
			/>
		</div>
	</div>

	<div class="post-card">
		<div class="post-card-title">On this page</div>
		<nav class="post-toc" id="post-toc" aria-label="On this page">
			{
				tocEntries.length > 0 ? (
					tocEntries.map((h: MarkdownHeading) => (
						<a
							class={h.depth === 3 ? "toc-link toc-h3" : "toc-link"}
							href={`#${h.slug}`}
						>
							{h.text}
						</a>
					))
				) : (
					<span class="post-toc-empty" data-toc-empty>
						No sections yet
					</span>
				)
			}
		</nav>
	</div>

	{seriesContext && <SeriesSidebarNav context={seriesContext} />}

	{
		!isArchive && (
			<div class="post-card">
				<section class="ads-section ads-section--rail" aria-label="Ads">
					<h2 class="ads-section-title">Ads</h2>
					<div id="blog-ads" class="ads-slot">
						<ins
							class="adsbygoogle"
							style="display:inline-block;width:336px;height:280px"
							data-ad-client="ca-pub-2480387803052595"
							data-ad-slot="3981831087"
						/>
						<script is:inline>
							(adsbygoogle = window.adsbygoogle || []).push({});
						</script>
					</div>
				</section>
			</div>
		)
	}
</aside>
