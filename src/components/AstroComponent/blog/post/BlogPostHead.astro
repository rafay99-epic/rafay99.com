---
import BaseHead from "@astro/base/BaseHead.astro";

interface Props {
	title: string;
	description: string;
	heroImage?: string;
	keywords?: string[];
	pageUrl: string;
	openGraphImageUrl: string;
	pubDate: Date;
	authorName: string;
	authorAvatar?: string;
	tags?: string[];
	readTime?: string;
	blogContent?: string;
	updatedDate?: Date;
	featured?: boolean;
	excerpt?: string;
	canonicalUrl?: string;
	series?: string;
	seriesPart?: number;
}

const {
	title,
	description,
	heroImage,
	keywords,
	pageUrl,
	openGraphImageUrl,
	pubDate,
	authorName,
	authorAvatar,
	tags,
	readTime,
	blogContent,
	updatedDate,
	featured,
	excerpt,
	canonicalUrl,
	series,
	seriesPart,
} = Astro.props;

/** One canonical absolute URL for OG / Twitter / schema (fixes wrong default when sharing). */
const baseOrigin = Astro.site ?? Astro.url;
function toAbsoluteImageUrl(src: string | undefined | null): string {
	const s = typeof src === "string" ? src.trim() : "";
	if (!s) return new URL("/Rafay99.webp", baseOrigin).href;
	if (/^https?:\/\//i.test(s)) return s;
	const path = s.startsWith("/") ? s : `/${s}`;
	return new URL(path, baseOrigin).href;
}

const hasHero = Boolean(heroImage && String(heroImage).trim());
const shareImageAbsolute = hasHero
	? toAbsoluteImageUrl(heroImage)
	: toAbsoluteImageUrl(openGraphImageUrl) ||
		toAbsoluteImageUrl("/Rafay99.webp");

const wordCount = blogContent
	? blogContent.trim().split(/\s+/).filter(Boolean).length
	: 0;

// Escape `<` so author content containing a closing script tag can't break
// out of the JSON-LD script block (JSON.stringify doesn't escape angle
// brackets). Keep literal tags out of this comment: Vite's dependency
// scanner treats them as real script tags.
const toJsonLd = (value: unknown): string =>
	JSON.stringify(value).replace(/</g, "\\u003c");
---

{/* BaseHead is the single source for title, description, canonical, and the
core OG/Twitter tags. Here we only add article-specific metadata and JSON-LD. */}
<BaseHead
	title={title}
	description={excerpt || description}
	image={shareImageAbsolute}
	type="article"
	author={authorName}
	{...(canonicalUrl ? { canonical: canonicalUrl } : {})}
	{...(keywords !== undefined && keywords.length > 0 ? { keywords } : {})}
/>

    <style is:global>
      /* Prevent white flash - Critical styles */
      html {
        background-color: #1a1b26 !important;
      }

      body {
        background-color: #1a1b26 !important;
        transition: none !important;
      }

      .blog-container {
        background-color: #1a1b26 !important;
      }
    </style>

    <style is:inline>
      html {
        background-color: #1a1b26 !important;
      }
      body {
        background-color: #1a1b26 !important;
      }
      #__astro {
        background-color: #1a1b26 !important;
      }
    </style>

<script
	is:inline
	async
	type="text/plain"
	data-category="analytics"
	data-type="text/partytown"
	src="https://www.googletagmanager.com/gtag/js?id=G-DKPL4VGM52"></script>
<script
	is:inline
	type="text/plain"
	data-category="analytics"
	data-type="text/partytown"
>
	window.dataLayer = window.dataLayer || [];
	function gtag() {
		dataLayer.push(arguments);
	}
	gtag("js", new Date());

	gtag("config", "G-DKPL4VGM52");
</script>

<script
	is:inline
	type="application/ld+json"
	set:html={toJsonLd({
		"@context": "https://schema.org",
		"@type": "BlogPosting",
		headline: title,
		description: excerpt || description,
		image: shareImageAbsolute,
		author: {
			"@type": "Person",
			name: authorName,
			image: authorAvatar
				? new URL(authorAvatar, baseOrigin).toString()
				: new URL("/author.jpg", baseOrigin).toString(),
			url: baseOrigin.toString(),
		},
		publisher: {
			"@type": "Organization",
			name: "Rafay99",
			logo: {
				"@type": "ImageObject",
				url: new URL("/favicon.webp", baseOrigin).toString(),
			},
		},
		datePublished: pubDate.toISOString(),
		dateModified: updatedDate?.toISOString() || pubDate.toISOString(),
		mainEntityOfPage: {
			"@type": "WebPage",
			"@id": pageUrl,
		},
		keywords:
			keywords?.join(", ") ||
			tags?.join(", ") ||
			"blog, technology, programming",
		articleSection: tags?.[0] || "Technology",
		wordCount: wordCount,
		timeRequired: readTime || "5 min read",
		...(series
			? {
					isPartOf: {
						"@type": "CreativeWorkSeries",
						name: series,
						url: `${baseOrigin.toString().replace(/\/$/, "")}/blog/series/${series.toLowerCase().trim().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "")}`,
					},
					position: seriesPart,
				}
			: {}),
	})}
/>

<script
	is:inline
	type="application/ld+json"
	set:html={toJsonLd({
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{
				"@type": "ListItem",
				position: 1,
				name: "Home",
				item: baseOrigin.toString(),
			},
			{
				"@type": "ListItem",
				position: 2,
				name: "Blog",
				item: new URL("/blog", baseOrigin).toString(),
			},
			{
				"@type": "ListItem",
				position: 3,
				name: title,
				item: pageUrl,
			},
		],
	})}
/>

<meta
	name="robots"
	content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
/>
<meta name="googlebot" content="index, follow" />
<meta name="bingbot" content="index, follow" />

<meta property="article:published_time" content={pubDate.toISOString()} />
{
	updatedDate && (
		<meta
			property="article:modified_time"
			content={updatedDate.toISOString()}
		/>
	)
}
<meta property="article:author" content={authorName} />
{tags?.map((tag: string) => <meta property="article:tag" content={tag} />)}
<meta property="article:section" content={tags?.[0] || "Technology"} />
{featured && <meta property="article:featured" content="true" />}

<meta name="twitter:label1" content="Reading time" />
<meta name="twitter:data1" content={readTime || "5 min read"} />
<meta name="twitter:label2" content="Category" />
<meta name="twitter:data2" content={tags?.[0] || "Technology"} />

<meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests" />
