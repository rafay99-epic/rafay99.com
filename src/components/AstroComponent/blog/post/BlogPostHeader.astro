---
import SeriesBadge from "@astro/blog/series/SeriesBadge.astro";
import { formatDate } from "@astro/editorial/format";

interface Props {
	title: string;
	lead?: string;
	pubDate: Date;
	isArchive: boolean;
	authorName: string;
	authorAvatar?: string;
	readTime?: string;
	wordCount?: number;
	formattedWordCount?: string;
	tags?: string[];
	updatedDate?: Date;
	series?: string | undefined;
	seriesPart?: number | undefined;
	seriesTotal?: number | undefined;
}

const {
	title,
	lead,
	pubDate,
	isArchive,
	authorName,
	authorAvatar,
	readTime,
	wordCount = 0,
	formattedWordCount = "",
	tags,
	updatedDate,
	series,
	seriesPart,
	seriesTotal,
} = Astro.props;
---

<header class="post-header">
	<p class="post-eyebrow">
		<a class="post-back" href={isArchive ? "/blog/archive/" : "/blog/"}>
			← {isArchive ? "Archive" : "Writing"}
		</a>
		<span class="post-dot" aria-hidden="true">·</span>
		<time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
		{isArchive && <span class="post-badge">Archived · may be outdated</span>}
		{
			series && seriesPart && (
				<SeriesBadge series={series} part={seriesPart} total={seriesTotal} />
			)
		}
	</p>

	<h1 class="post-title">{title}</h1>

	{lead && <p class="post-lead">{lead}</p>}

	<div class="post-byline">
		<span class="post-author">
			{
				authorAvatar ? (
					<img
						src={authorAvatar}
						alt=""
						aria-hidden="true"
						width="32"
						height="32"
						decoding="async"
					/>
				) : (
					<span class="post-avatar-fallback" aria-hidden="true">
						{authorName?.charAt(0)?.toUpperCase()}
					</span>
				)
			}
			{authorName}
		</span>
		{readTime && <span>{readTime}</span>}
		{wordCount > 0 && formattedWordCount && <span>{formattedWordCount} words</span>}
		{updatedDate && <span>Updated {formatDate(updatedDate)}</span>}
	</div>

	{
		tags && tags.length > 0 && (
			<p class="post-tags">
				{tags.map((tag: string) => (
					<a class="post-tag" href={`/tag/${tag}/`}>
						#{tag}
					</a>
				))}
			</p>
		)
	}
</header>
