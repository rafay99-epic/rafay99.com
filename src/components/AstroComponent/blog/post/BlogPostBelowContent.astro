---
import type { CollectionEntry } from "astro:content";
import PostComment from "@astro/blog/comments/PostComment.astro";
import CodeCopySimple from "@react/blog/enhancements/code-copy/CodeCopySimple";
import EnhancedImageCaptionRenderer from "@react/blog/enhancements/image-caption-renderer/EnhancedImageCaptionRenderer";

interface Props {
	isArchive: boolean;
	prevPost?: CollectionEntry<"blog">;
	nextPost?: CollectionEntry<"blog">;
}

const { isArchive, prevPost, nextPost } = Astro.props;
// Posts are ordered oldest first: previous is older, next is newer.
const base = isArchive ? "/blog/archive" : "/blog";
---

{
	!isArchive && (
		<>
			<EnhancedImageCaptionRenderer client:load />
			<CodeCopySimple client:idle />
		</>
	)
}

{
	(prevPost || nextPost) && (
		<nav class="post-next" aria-label="More writing">
			{prevPost ? (
				<a class="post-next__link" href={`${base}/${prevPost.id}/`}>
					<span class="post-next__dir">← Previous</span>
					<span class="post-next__title">{prevPost.data.title}</span>
				</a>
			) : (
				<span />
			)}
			{nextPost && (
				<a class="post-next__link is-next" href={`${base}/${nextPost.id}/`}>
					<span class="post-next__dir">Next →</span>
					<span class="post-next__title">{nextPost.data.title}</span>
				</a>
			)}
		</nav>
	)
}

{
	!isArchive && (
		<section class="comments-section" aria-labelledby="discussion-title">
			<div class="comments-section__inner">
				<h2 id="discussion-title" class="comments-section__title">
					Discussion
				</h2>
				<PostComment />
			</div>
		</section>
	)
}

<style>
	.post-next {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
		width: 100%;
		max-width: 1280px;
		margin: 0 auto clamp(3rem, 6vw, 4.5rem);
		padding-inline: clamp(1.25rem, 4vw, 3rem);
	}

	.post-next__link {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 2rem 0;
		border-top: 1px solid var(--color-line);
		text-decoration: none;
	}

	.post-next__link.is-next {
		align-items: flex-end;
		text-align: right;
	}

	.post-next__dir {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--color-text-soft);
	}

	.post-next__title {
		max-width: 24ch;
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 2.2vw, 1.75rem);
		font-weight: 600;
		line-height: 1.12;
		letter-spacing: -0.03em;
		color: var(--color-text-primary);
		transition: color var(--dur-2);
	}

	.post-next__link:hover .post-next__title {
		color: var(--color-secondary);
	}

	.post-next__link:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 4px;
	}

	@media (max-width: 767px) {
		.post-next {
			grid-template-columns: 1fr;
		}

		.post-next__link.is-next {
			align-items: flex-start;
			text-align: left;
		}
	}
</style>
