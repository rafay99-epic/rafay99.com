---
import PageHead from "@astro/editorial/PageHead.astro";
import Pager from "@astro/editorial/Pager.astro";
import PostIndex from "@astro/editorial/PostIndex.astro";
import TopicList from "@astro/editorial/TopicList.astro";
import { countTags, getPublishedPosts } from "@util/collections";
import type { Post } from "types/articles";

interface Props {
	paginatedPosts: Post[];
	selectedTag: string | null;
	currentPage: number;
	totalPages: number;
}

const { paginatedPosts, selectedTag, currentPage, totalPages } = Astro.props;
const published = await getPublishedPosts();
const tags = countTags(published);
const selectedCount = selectedTag
	? (tags.find(([tag]) => tag === selectedTag)?.[1] ?? 0)
	: published.length;

const base = selectedTag ? `/tag/${selectedTag}/` : "/tag/";
const pageBase = selectedTag ? `/tag/${selectedTag}/page/` : "/tag/page/";
---

{
  selectedTag ? (
    <PageHead
      lines={[`#${selectedTag}`]}
      size="md"
      lede={`${selectedCount} ${selectedCount === 1 ? "post" : "posts"} tagged ${selectedTag}.`}
    >
      <p class="ed-mono tagv__back">
        <a class="ed-link" href="/tag/">← all topics</a>
      </p>
    </PageHead>
  ) : (
    <PageHead
      lines={["Every", "topic."]}
      accent={1}
      lede={`${tags.length} topics across ${published.length} posts. Bigger means I keep coming back to it.`}
    />
  )
}

<div class="ed-wrap">
  <section class="ed-section">
    <TopicList tags={tags} selected={selectedTag} />
  </section>

  <section class="ed-section">
    <div class="ed-section__head">
      <h2 class="ed-h2">
        {selectedTag ? <>Tagged <em>{selectedTag}</em></> : "All posts"}
      </h2>
      <span class="ed-mono">
        page {currentPage} / {Math.max(1, totalPages)}
      </span>
    </div>
    <PostIndex posts={paginatedPosts} start={(currentPage - 1) * 10} level={3} />
    <Pager current={currentPage} total={totalPages} base={base} pageBase={pageBase} />
  </section>
</div>

<style>
  .tagv__back {
    margin-top: 1rem;
  }
</style>
