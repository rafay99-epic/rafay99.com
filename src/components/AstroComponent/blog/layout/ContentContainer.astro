---
interface Props {
	class?: string;
	withBackground?: boolean;
}

const { class: className = "", withBackground = true } = Astro.props;
---

<style>
  @media (max-width: 768px) {
    .content-container {
      padding: 24px;
      margin-top: 24px;
    }
  }
</style>

<div
  class={`content-container ${withBackground ? "with-background" : ""} ${className}`}
>
  <div class="content-wrapper">
    <slot />
  </div>
</div>
