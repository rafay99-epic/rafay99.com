---
import BaseHead from "@astro/base/BaseHead.astro";
import Footer from "@astro/footer/Footer.astro";
import Header from "@astro/header/Header.astro";
import ExperienceSection from "@astro/personal/Experience/ExperienceSection.astro";
import { featureFlags } from "@config/featureFlag/featureFlag.json";
import authorConfig from "@config/siteConfig/info.json";

export const prerender = true;
try {
	if (!featureFlags.showExperience) {
		return Astro.redirect("/access-denied");
	}
} catch (_error) {
	return Astro.redirect("/500");
}
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Experience | ${authorConfig.SiteName}`}
      description="Six roles, from ML engineering to AI systems in production."
    />

  </head>
  <body>
    <Header />
    <main class="ed">
      <ExperienceSection />
    </main>
    <Footer />
  </body>
</html>
