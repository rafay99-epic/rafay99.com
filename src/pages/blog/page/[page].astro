---
import BlogPage from "@astro/editorial/BlogPage.astro";
import { featureFlags } from "@config/featureFlag/featureFlag.json";
import { getPublishedPosts, POSTS_PER_PAGE } from "@util/collections";

export const prerender = true;

export async function getStaticPaths() {
	const total = Math.ceil((await getPublishedPosts()).length / POSTS_PER_PAGE);
	return Array.from({ length: Math.max(0, total - 1) }, (_, i) => ({
		params: { page: String(i + 2) },
	}));
}

if (!featureFlags.showBlog) {
	return Astro.redirect("/access-denied");
}

const page = Number.parseInt(Astro.params.page ?? "", 10);
---

<BlogPage page={page} />
